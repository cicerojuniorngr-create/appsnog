# Copie este arquivo para ".env" e preencha com os valores reais.
# O ".env" está no .gitignore: ele fica só no seu computador.

# Conta Gmail criada só para o robô (quem ENVIA os e-mails)
EMAIL_REMETENTE=
# Senha de app de 16 letras gerada no Google (não é a senha normal da conta)
SENHA_APP_EMAIL=
# Quem recebe os avisos de edital
EMAIL_DESTINATARIO=
# Quem recebe o resumo semanal e os alertas de falha (você)
EMAIL_ADMIN=
